# Ollama cloud via your own local Ollama service; no weights are downloaded.
# On this project's original PC the service uses 11435; a normal install uses 11434.
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=gpt-oss:120b-cloud
JARVIS_OLLAMA_CLOUD_ONLY=true

# Optional alternate providers: insert YOUR keys only in your local .env.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JARVIS_GEMINI_MODEL=gemini-3.8-flash

# No API key or subscription is needed for these voice options.
JARVIS_TTS_ENGINE=edge
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=-5%
JARVIS_VOICE_PITCH=-8Hz
JARVIS_OFFLINE_VOICE=english
JARVIS_OFFLINE_RATE=170
# Set JARVIS_TTS_ENGINE=pyttsx3 for offline speech output.
# JARVIS_ADB_PATH=/absolute/path/to/platform-tools/adb

# Terminal and optional tool timeout: 1 hour, 3 minutes, 50 seconds.
JARVIS_TOOL_TIMEOUT=3830

# Input device index from: jarvis --list-microphones (blank = system default)
JARVIS_MIC_INDEX=
# Enable ALSA/JACK driver diagnostics only when troubleshooting
JARVIS_AUDIO_DEBUG=0

# Optional private memory location; default is ~/.local/share/jarvis/memory
# JARVIS_MEMORY_DIR=/absolute/path/to/private/memory
